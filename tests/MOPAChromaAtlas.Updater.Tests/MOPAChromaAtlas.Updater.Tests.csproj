<!--
  Tests for the in-place updater (src/MOPAChromaAtlas/Updates/UpdateService.cs) and the
  built-in release notes. Compiles those source files directly, without Avalonia, so it runs
  anywhere .NET does, CI runners with no display included. It builds real release-shaped
  zips, serves them through a local release feed, and installs them over a fake installed
  copy: good updates land, every tampered one is refused with nothing changed.

  The install tests use shell scripts as stand-in programs, so they run on Linux and macOS
  and return early on Windows. The version and notes tests run everywhere.
-->
<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <RootNamespace>MOPAChromaAtlas.Tests</RootNamespace>
    <!-- The updater compares against BuildInfo.Version, which reads this assembly's version. -->
    <Version>1.3.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.1" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
    <Compile Include="..\..\src\MOPAChromaAtlas\Updates\UpdateService.cs" Link="Linked\UpdateService.cs" />
    <Compile Include="..\..\src\MOPAChromaAtlas\Updates\ReleaseNotes.cs" Link="Linked\ReleaseNotes.cs" />
    <Compile Include="..\..\src\MOPAChromaAtlas\BuildInfo.cs" Link="Linked\BuildInfo.cs" />
    <Compile Include="..\..\src\MOPAChromaAtlas\AppPreferences.cs" Link="Linked\AppPreferences.cs" />
    <EmbeddedResource Include="..\..\CHANGELOG.md" LogicalName="MOPAChromaAtlas.CHANGELOG.md" />
  </ItemGroup>

</Project>
