<Project Sdk="Microsoft.NET.Sdk">

  <!--
    UI-free engine: colour science, the MOPA parameter model, grid planning and
    export, and the atlas store. Everything here is testable without a window, and
    a future command-line front end can use it unchanged.
  -->
  <PropertyGroup>
    <RootNamespace>MOPAChroma</RootNamespace>
    <AssemblyName>MOPAChroma.Core</AssemblyName>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="MOPAChroma.Core.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- Same imaging library and version as DepthView: reads PNG, TIFF, JPEG, BMP on every platform. -->
    <PackageReference Include="SixLabors.ImageSharp" Version="$(ImageSharpVersion)" />
  </ItemGroup>

  <ItemGroup>
    <!-- The laser libraries this solution shares with other programs (DepthView). -->
    <Using Include="LumosUltra.Jobs" />
    <Using Include="LumosUltra.Camera" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\LumosUltra.Jobs\LumosUltra.Jobs.csproj" />
    <ProjectReference Include="..\LumosUltra.Camera\LumosUltra.Camera.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Angle capture: reading capture packages (MOPAChroma Capture, a sister repository). -->
    <ProjectReference Include="$(CaptureRoot)src\MOPAChroma.Capture.Core\MOPAChroma.Capture.Core.csproj" />
  </ItemGroup>

</Project>
